    {
      "interpretAs": "\n\n\n\n",
      "markup": "</p>\n<ul>\n<li>",
      "offset": {
        "end": 1056,
        "start": 1042
      }
    },
    {
      "offset": {
        "end": 1106,
        "start": 1056
      },
      "text": "Create a simple, lightweight parser in JavaScript."
    },
    {
      "interpretAs": "\n",
      "markup": "</li>\n<li>",
      "offset": {
        "end": 1116,
        "start": 1106
      }
    },
    {
      "offset": {
        "end": 1185,
        "start": 1116
      },
      "text": "Be portable across editors that leverage JavaScript in their plugins."
