    {
      "offset": {
        "end": 965,
        "start": 853
      },
      "text": "Tdhis makes perfect sense. LanguageTool is meant to parse and analyze natural languages, not computer languages."
    },
    {
      "interpretAs": "\n\n\n",
      "markup": "</p>\n<h2 id=\"goals\">",
