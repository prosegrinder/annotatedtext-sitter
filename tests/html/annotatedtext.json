        "start": 634
      }
    },
    {
      "offset": {
        "end": 827,
        "start": 703
      },
      "text": "“LT only works on plain text, so you’ll need to either convert Markdown to plain text first, or tell LT what the markup is.”"
    },
    {
      "interpretAs": "",
      "markup": "</a> ",
      "offset": {
        "end": 832,
        "start": 827
      }
    },
    {
      "offset": {
        "end": 845,
        "start": 832
      },
      "text": "Pretty clear."
